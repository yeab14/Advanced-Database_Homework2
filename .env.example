# Copy this file to .env and fill in your own PostgreSQL install.
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux / macOS)
#
# A normal install uses port 5432. The PC we tested on runs
# PostgreSQL 18.2 on port 5400, so that machine's .env sets HW2_DB_PORT=5400.

HW2_DB_HOST=127.0.0.1
HW2_DB_PORT=5432
HW2_DB_NAME=adb_hw2
HW2_DB_USER=hw2
HW2_DB_PASSWORD=hw2

# Optional. If set, this replaces host, port, and database name.
# HW2_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/adb_hw2
